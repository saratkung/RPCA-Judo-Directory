# ===== Google Sheets =====
# ID ของ Google Spreadsheet (ดูได้จาก URL ระหว่าง /d/ กับ /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# ชื่อแท็บ (ตามหางแท็บล่างซ้ายของ Google Sheets จริง เช่น Sheet1, Members)
# + ช่วงคอลัมน์ที่จะอ่าน ต้องครอบคลุมหัวตารางถึงคอลัมน์สุดท้าย (A ถึง H)
# ชื่อแท็บผิด = Google Sheets API จะตอบ 400 Unable to parse range
GOOGLE_SHEETS_RANGE=Sheet1!A:H

# อีเมลของ Service Account ที่สร้างจาก Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key ของ Service Account (จากไฟล์ JSON คีย์)
# ต้องครอบด้วยเครื่องหมายคำพูดและคงบรรทัด -----BEGIN PRIVATE KEY-----
# หากเก็บในไฟล์ .env ให้แทนขึ้นบรรทัดใหม่ด้วย \n (โค้ดจะแปลงให้อัตโนมัติ)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# ===== LINE Messaging API =====
# Channel Secret จาก LINE Developers Console (ใช้ตรวจสอบ Webhook Signature)
LINE_CHANNEL_SECRET=

# Channel Access Token (long-lived) จาก LINE Developers Console
LINE_CHANNEL_ACCESS_TOKEN=

# ===== เว็บไซต์ =====
# URL ของเว็บไซต์หลัง Deploy (ใช้สร้างลิงก์โปรไฟล์สมาชิกในคำตอบของ LINE)
# ตอน dev ในเครื่องให้ใช้ http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
